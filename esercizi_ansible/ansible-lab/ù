---
- name: Crea rete Docker dedicata per Jenkins
  community.docker.docker_network:
    name: jenkins_network
    state: present

- name: Crea volume Docker per il controller
  community.docker.docker_volume:
    name: jenkins_home
    state: present

- name: Distribuisci il container Jankins Controller 
  community.docker.docker_container:
    name: jenkins_controller
    image: jenkins/jenkins:lts
    state: started
    restart_policy: unless-stopped
    networks:
      - name: jenkins_network
    published_port:
      - "8080:8080"
      - "50000:50000"
    volumes:
      - jenkins_home:/var/jenkins_home
