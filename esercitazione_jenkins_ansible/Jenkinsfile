pipeline {
    agent { label 'docker' }

    parameters {
        booleanParam(name: 'ESEGUI_DAVVERO', defaultValue: false,
                     description: 'Se falso, esegue solo in modalità --check (dry-run)')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/gabriele-riccio/formazione_sou.git'
            }
        }

        stage('Test connessione Ansible') {
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'rocky9-ssh-key', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER'),
                    file(credentialsId: 'ansible-vault-pass', variable: 'VAULT_PASS_FILE')
                ]) {
                    dir('esercizi_ansible/ansible-lab') {
                        sh '''
                            export ANSIBLE_VAULT_PASSWORD_FILE=$VAULT_PASS_FILE
                            ansible rocky9 -m ping \
                              -e ansible_ssh_private_key_file=$SSH_KEY \
                              -u $SSH_USER
                        '''
                    }
                }
            }
        }

        stage('Esegui playbook docker_stack') {
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'rocky9-ssh-key', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER'),
                    file(credentialsId: 'ansible-vault-pass', variable: 'VAULT_PASS_FILE')
                ]) {
                    dir('esercizi_ansible/ansible-lab') {
                        script {
                            def checkFlag = params.ESEGUI_DAVVERO ? '' : '--check --diff'
                            sh """
                                export ANSIBLE_VAULT_PASSWORD_FILE=\$VAULT_PASS_FILE
                                ansible-playbook playbooks/docker_stack.yml \
                                  -e ansible_ssh_private_key_file=\$SSH_KEY \
                                  -u \$SSH_USER \
                                  ${checkFlag}
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline completata. Modalità: ${params.ESEGUI_DAVVERO ? 'esecuzione reale' : 'dry-run (--check)'}"
        }
        failure {
            echo 'Qualcosa è fallito, controlla i log della console'
        }
    }
}
